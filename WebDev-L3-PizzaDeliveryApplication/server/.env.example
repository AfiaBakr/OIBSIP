# Server
PORT=5000
CLIENT_URL=http://localhost:5173
# Set to 1 when running behind a hosting proxy such as Render
TRUST_PROXY=
MONGO_URI=mongodb://127.0.0.1:27017/pizza_delivery
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Admin account (created by `npm run seed`)
ADMIN_NAME=Store Admin
ADMIN_EMAIL=admin@pizza.local
ADMIN_PASSWORD=Admin@123
# Where low-stock alerts are sent (defaults to ADMIN_EMAIL)
ADMIN_ALERT_EMAIL=

# Email (SMTP). Leave SMTP_HOST empty to print emails to the server console instead.
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true, SMTP_PASS=<app password>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Pizza Palace <no-reply@pizza.local>"

# Razorpay test-mode keys (https://dashboard.razorpay.com/app/keys).
# Leave both empty to use the built-in mock checkout.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Low-stock alert job
# Default threshold for new inventory items (each item's threshold can be edited by the admin)
LOW_STOCK_THRESHOLD=20
# node-cron schedule for the check (default: every 30 minutes)
LOW_STOCK_CRON=*/30 * * * *
